    tgModP (if r.2.1 == 2 then tgWedgeCoef (tgD6.getD r.1 []) (tgI2.getD r.2.2 []) M
            else tgWedgeCoef (tgI4.getD r.1 []) (tgI4.getD r.2.2 []) M)

