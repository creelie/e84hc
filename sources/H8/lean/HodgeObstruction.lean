/-- the cases `(n, d, k, |T|, rank, rows)`. -/
def vtCases : List (Nat × Nat × Nat × Nat × Nat × List (Nat × Nat × List Nat × List Nat)) := [
  (2, 1, 1, 16, 16, vt211Rows),
