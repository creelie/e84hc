    if r.2.1 == 2 then fmWedge 16 (tgI4.getD r.1 []) (tgI2.getD r.2.2 [])
    else fmWedge 16 (tgI2.getD r.1 []) (tgI4.getD r.2.2 [])

/-- the minor of the degree-eight products on the recorded monomials. -/
def tgRows8 : List (List Nat) :=
